# Documentação e anotações do desenvolvedor não são páginas do sistema: não servir pelo navegador.
<FilesMatch "\.(md|sql|txt|log|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
