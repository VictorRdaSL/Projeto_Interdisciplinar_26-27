# Raiz do repositório: nada daqui deve ser servido pelo navegador.
# (Em produção, publique só a pasta SistemaEditorial/ — nunca a raiz do repositório.)

# Pasta .git (histórico, config, hooks) e documentos internos
RedirectMatch 403 "(^|/)\.git(/|$)"

<FilesMatch "(\.(md|sql|txt|log|bak)|^\.gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Sem listagem de pastas (img/ e outras): quem abre a pasta no navegador recebe 403, não a lista de arquivos.
Options -Indexes
